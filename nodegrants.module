<?php

/**
 * @file
 * Control access to site content based on the users and roles.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\user\RoleInterface;
use Drupal\user\Entity\Role;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\node\NodeTypeInterface;
use Drupal\Core\Access\AccessResult;
use Drupal\node\NodeInterface;
use Drupal\node\Entity\NodeType;
use Drupal\node\Entity\Node;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Url;

/**
 * Implements hook_help().
 */
function nodegrants_help($route_name, RouteMatchInterface $route_match) {
  $nodegrants_text = "
  <h1>Nodegrants - Node Access Control for Drupal</h1>

  <h2>INTRODUCTION</h2>

  <p>This module is now fully Drupal 12 compatible and will be maintained to remain so.
  Many interface and feature enhancements have been made as part of the code cleanup
  and the fixing of bugs. Please see the GitHub Wiki for this project to get a complete
  set of documentation on how to use this module as well as how to update form previous
  versions of Nodeaccess that have been hosted on Drupal.org. This is also the place
  to learn how to configure Nodegrants. That information has been removed from this file
  as it was tough to understand without the visuals.</p>

  <a href=\"https://github.com/ElusiveMind/nodeaccess/wiki\" target=\"new\">Nodegrants Wiki</a>

  <p>This module allows you to manage permissions for nodes by role and user. In
  other words, it implements per node access control for users and groups. With
  this module, you can restrict access to any individual node without having to
  use taxonomy. You can assign permission to view, edit or delete each
  individual node by user or role. Once enabled, a 'grant' tab will appear on
  node pages. You can click this and assign permissions for that node.</p>

  <p>For a full description of the module, visit the project page below. That is also the
  place to submit pull requests.</p>

  <a href=\"https://github.com/ElusiveMind/nodeaccess\" target=\"new\">Nodegrants GitHub repository</a>

  <p>To submit bug reports, feature suggestions:</p>

  <a href=\"https://github.com/ElusiveMind/nodeaccess/issues\" target=\"new\">Nodegrants issue queue</a>";

  switch ($route_name) {
    case 'help.page.nodegrants':
      return $nodegrants_text;
      break;

  }
}

/**
 * Implements hook_node_access_records().
 */
function nodegrants_node_access_records(NodeInterface $node) {
  $db = \Drupal::database();
  $settings = \Drupal::configFactory()->get('nodegrants.settings');
  $bundle = $node->getType();
  $type = NodeType::load($bundle);

  // Need to find out if node has own grants or whether to use defaults.
  $default = $settings->get($bundle);
  $roles_gids = $settings->get('role_map');

  $nid = $node->id();
  $grants = [];

  // Setup default keys that are required by node_access_write_grants().
  $grant_defaults = [
    'nid' => $nid,
    'gid' => 0,
    'realm' => 'nodegrants_rid',
    'grant_view' => 0,
    'grant_update' => 0,
    'grant_delete' => 0,
  ];

  /**
   * A node's stored grants only count while nodegrants is turned on for its
   * content type. Turning the type off leaves the rows in place but ignores
   * them, so its nodes fall back to Drupal's content permissions; turning it
   * back on brings them back. Both need a node access rebuild, which
   * nodegrants_node_type_presave() flags.
   */
  $enabled = FALSE;
  if (nodegrants_type_enabled($type)) {
    $entries = $db->select('nodegrants_nodes_enabled', 'n')
      ->fields('n')
      ->condition('nid', $node->id(), '=')
      ->execute()
      ->fetchAll();
    $enabled = (count($entries) > 0) ? TRUE : FALSE;
  }

  if ($enabled === FALSE) {
    if ($node->isPublished()) {
      $anonymous_role = Role::load(RoleInterface::ANONYMOUS_ID);
      $authenticated_role = Role::load(RoleInterface::AUTHENTICATED_ID);
      // Anonymous user setting.
      $grants[] = [
        'gid' => $roles_gids[RoleInterface::ANONYMOUS_ID],
        'grant_view' => (int) $anonymous_role->hasPermission('access content'),
      ];
      // Authenticated user setting.
      $grants[] = [
        'gid' => $roles_gids[RoleInterface::AUTHENTICATED_ID],
        'grant_view' => (int) $authenticated_role->hasPermission('access content'),
      ];
    }
  }
  else {
    $entries = $db->select('nodegrants', 'n')
      ->fields('n')
      ->condition('nid', $nid, '=')
      ->execute()
      ->fetchAll();
    $node_count = count($entries);

    if ($node_count < 1 || $enabled === FALSE) {
      /**
       * If the node has no grants of its own, make it available to anonymous
       * and authenticated if they have permissions properly configured. We do
       * not use default grants outside of the node grants being enabled on a
       * per node basis.
       */
      if ($node->isPublished() && !empty($default)) {
        $i = 0;
        foreach ($default as $key => $val) {
          if ($key != 'author') {
            $rid = $roles_gids[$key];
            $grants[$i] = $default[$key];
            $grants[$i]['gid'] = $rid;
            $i++;
          }
        }
      }
      else {
        // Otherwise, check access to unpublished content for authenticated and
        // anonymous users.
        $anonymous_role = Role::load(RoleInterface::ANONYMOUS_ID);
        $authenticated_role = Role::load(RoleInterface::AUTHENTICATED_ID);
        // Anonymous user setting.
        $grants[] = [
          'gid' => $roles_gids[RoleInterface::ANONYMOUS_ID],
          'grant_view' => (int) $anonymous_role->hasPermission('bypass node access'),
        ];
        // Authenticated user setting.
        $grants[] = [
          'gid' => $roles_gids[RoleInterface::AUTHENTICATED_ID],
          'grant_view' => (int) $authenticated_role->hasPermission('bypass node access'),
        ];
      }
    }
    else {
      // Node has own grants, use them. The stored author row is skipped; it
      // holds whoever owned the node when its grants were last saved.
      $entries = $db->select('nodegrants', 'n')
        ->fields('n')
        ->condition('nid', $nid, '=')
        ->execute()
        ->fetchAll();

      $grants = [];
      foreach ($entries as $row) {
        if ($row->realm == 'nodegrants_author') {
          continue;
        }
        $grants[] = [
          'gid' => $row->gid,
          'realm' => $row->realm,
          'grant_view' => $row->grant_view,
          'grant_update' => $row->grant_update,
          'grant_delete' => $row->grant_delete,
        ];
      }
    }

    /**
     * Author grants come from the content type defaults and go to the node's
     * current owner, so they follow the node when its owner changes. Nodes
     * owned by the anonymous user get none: every anonymous visitor is uid 0.
     */
    $owner_id = (int) $node->getOwnerId();
    if ($owner_id > 0) {
      $grants[] = [
        'gid' => $owner_id,
        'realm' => 'nodegrants_author',
        'grant_view' => (int) $type->getThirdPartySetting('nodegrants', 'nodegrants_' . $bundle . '_author_view', FALSE),
        'grant_update' => (int) $type->getThirdPartySetting('nodegrants', 'nodegrants_' . $bundle . '_author_update', FALSE),
        'grant_delete' => (int) $type->getThirdPartySetting('nodegrants', 'nodegrants_' . $bundle . '_author_delete', FALSE),
      ];
    }
  }
  $updated_grants = [];
  foreach ($grants as $id => $grant) {
    // Merge missing default grant keys.
    $updated_grants[] = $grants[$id] + $grant_defaults;
  }

  return $updated_grants;
}

/**
 * Implements hook_node_grants().
 */
function nodegrants_node_grants(AccountInterface $account, $op) {
  $config = \Drupal::configFactory()->get('nodegrants.settings');
  $role_map = $config->get('role_map');
  $roles = $account->getRoles();

  $rids = [];
  foreach ($roles as $role) {
    if (isset($role_map[$role])) {
      $rids[] = $role_map[$role];
    }
  }

  $access = [
    'nodegrants_rid' => $rids,
    'nodegrants_uid' => [$account->id()],
  ];
  // Anonymous visitors all share uid 0, so none of them is an author.
  if ($account->isAuthenticated()) {
    $access['nodegrants_author'] = [$account->id()];
  }

  return $access;
}

/**
 * Implements hook_entity_update().
 */
function nodegrants_entity_update(EntityInterface $entity) {
  $config = \Drupal::configFactory()->getEditable('nodegrants.settings');

  if ($entity instanceof RoleInterface) {
    /**
     * We use to update our aliases here, but in the new version of nodegrants
     * we're not using separate aliases. Leaving this function here in the event
     * we need it later, but the TODO here is to remove it if it is not necessary.
     */
  }
}

/**
 * Implements hook_entity_insert().
 */
function nodegrants_entity_insert(EntityInterface $entity) {
  $config = \Drupal::configFactory()->getEditable('nodegrants.settings');
  if ($entity instanceof RoleInterface) {
    // The role map doesn't exist yet if roles are created before
    // nodegrants_install() runs.
    $roles_gids = array_flip($config->get('role_map') ?? []);
    $roles_gids[] = $entity->id();
    $config->set('role_map', array_flip($roles_gids));
    $config->save();
  }
}

/**
 * Implements hook_entity_delete().
 */
function nodegrants_entity_delete(EntityInterface $entity) {
  $config = \Drupal::configFactory()->getEditable('nodegrants.settings');

  if ($entity instanceof RoleInterface) {
    $roles_gids = $config->get('role_map') ?? [];
    unset($roles_gids[$entity->id()]);
    $config->set('role_map', $roles_gids);
    $config->save();
  }
}

/**
 * Implements hook_node_delete().
 */
function nodegrants_node_delete(EntityInterface $node) {
  // Deleting node, delete related permissions.
  $db = \Drupal::database();
  $nid = $node->id();
  $db->delete('nodegrants')
    ->condition('nid', $nid)
    ->execute();
  $db->delete('nodegrants_nodes_enabled')
    ->condition('nid', $nid)
    ->execute();
}

/**
 * Implements hook_ENTITY_TYPE_delete().
 */
function nodegrants_node_type_delete(NodeTypeInterface $type) {
  $config = \Drupal::configFactory()->getEditable('nodegrants.settings');
  $allowed_types = $config->get('allowed_types');
  unset($allowed_types[$type->id()]);
  $config->clear($type->id())
    ->set('allowed_types', $allowed_types)
    ->save();
}

/**
 * Implements hook_node_access().
 */
function nodegrants_node_access(NodeInterface $node, $op, $account) {
  $settings = \Drupal::configFactory()->get('nodegrants.settings');
  $role_map = $settings->get('role_map');
  $access = NULL;

  switch ($op) {
    case 'update':
    case 'delete':
      $type = NodeType::load($node->bundle());

      /**
       * While nodegrants is turned off for the content type, grants stored for
       * the node are ignored and Drupal's content permissions decide.
       */
      if (!nodegrants_type_enabled($type)) {
        $access = AccessResult::neutral()->addCacheableDependency($type);
        break;
      }

      $access = AccessResult::forbidden();
      // We check if the role has particular access to this node.
      $grants = _nodegrants_get_grants($node);
      $uid = $account->id();

      // If the node belongs to a deleted user.
      if ($uid == 0 && $node->getOwnerId() == 0) {
        // We check if the role has particular access to this node.
        $anonymous_rid = $role_map[RoleInterface::ANONYMOUS_ID];
        // If anonymous has rights to this node, we allow them.
        if ((!empty($grants['rid'][$anonymous_rid]['grant_update']) && $op == 'update') ||
          (!empty($grants['rid'][$anonymous_rid]['grant_delete']) && $op == 'delete')) {
          $access = AccessResult::allowed();
        }
        else {
          $access = AccessResult::forbidden();
        }
      }
      else {
        if (!empty($grants['uid']) && array_key_exists($uid, $grants['uid'])) {
          if ((!empty($grants['uid'][$uid]['grant_update']) && $op == 'update') ||
              (!empty($grants['uid'][$uid]['grant_delete']) && $op == 'delete')) {
            $access = AccessResult::allowed();
          }
        }
        else if (!empty($grants['rid'])) {
          $access = AccessResult::forbidden();
          foreach ($account->getRoles() as $rid) {
            if (!isset($role_map[$rid])) {
              continue;
            }
            $rid = $role_map[$rid];
            if ((!empty($grants['rid'][$rid]['grant_update']) && $op == 'update') ||
                (!empty($grants['rid'][$rid]['grant_delete']) && $op == 'delete')) {
              $access = AccessResult::allowed();
            }
          }
        }
        else {
          $access = AccessResult::neutral();
        }

        // The node's owner also gets the content type's author grants, when
        // nodegrants controls this node (it has role or user grants).
        if (!empty($grants) && !$access->isAllowed() && $uid == $node->getOwnerId()
          && $type->getThirdPartySetting('nodegrants', 'nodegrants_' . $node->bundle() . '_author_' . $op, FALSE)) {
          $access = AccessResult::allowed();
        }
      }

      // The result depends on the node's grants and owner, and on whether
      // nodegrants is turned on for its content type.
      $access->cachePerUser()->addCacheableDependency($node)->addCacheableDependency($type);
      break;

    default:
      break;
  }
  return $access;
}

/**
 * Return the grants applied to a node object used for Grant form.
 *
 * @return array
 *   An array of grants with keys 'rid' for roles and 'uid' for users.
 */
function _nodegrants_get_grants($node) {

  $grants = [];
  $db = \Drupal::database();

  // Load all roles.
  $result = $db->select('nodegrants', 'na')
    ->fields('na', ['gid', 'grant_view', 'grant_update', 'grant_delete'])
    ->condition('nid', $node->id(), '=')
    ->condition('realm', 'nodegrants_rid', '=')
    ->execute()
    ->fetchAll();
  foreach ($result as $grant) {
    $grants['rid'][$grant->gid] = [
      'grant_view' => $grant->grant_view,
      'grant_update' => $grant->grant_update,
      'grant_delete' => $grant->grant_delete,
    ];
  }

  // Load users from node_access.
  $entries = $db->select('nodegrants', 'n');
  $entries->join('users_field_data', 'ufd', 'ufd.uid = n.gid');
  $entries->fields('n', ['grant_view', 'grant_update', 'grant_delete']);
  $entries->fields('ufd', ['uid', 'name']);
  $entries->condition('n.nid', $node->id(), '=');
  $entries->condition('n.realm', 'nodegrants_uid', '=');
  $entries->orderBy('ufd.name', 'ASC');
  $results = $entries->execute();

  foreach ($results as $account) {
    $grants['uid'][$account->uid] = [
      'name' => $account->name,
      'grant_view' => $account->grant_view,
      'grant_update' => $account->grant_update,
      'grant_delete' => $account->grant_delete,
    ];
  }

  return $grants;
}

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * Rationale:
 * In Drupal, if you give an authenticated user access to something, you basically give
 * all authenticated users access to it. Because every logged in user, regardless of
 * any other role, is authenticated. As such, if you elect to give authenticated users
 * access, you are giving acccess to all roles.
 *
 * The interface needs to reflect this so there is no confusion. So if a user opts to
 * grant access to the authenticated user, we will check the boxes on all roles except
 * anonymous.
 */
function nodegrants_form_node_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $db = \Drupal::database();
  $roles = Role::loadMultiple();

  /**
   * Get the node id (entity id) from the form object. Now..... if there is no form object
   * then there will be no nid which indicates a new node which then means we will be using
   * our defaults. Which is all fine, but we need to make sure we defensively program for
   * it.
   */

  $node_entity = $form_state->getFormObject()->getEntity();
  $nid = $node_entity->id();

  /**
   * Get the bundle from the node entity being edited.
   */
  $bundle = $node_entity->bundle();

  $type = NULL;
  if (!empty($bundle)) {
    $type = NodeType::load($bundle);
  }

  /**
   * If nodegrants is not enabled for this node type, then do not put the tab
   * on the form.
   */
  if (!nodegrants_type_enabled($type)) {
    return;
  }

  /**
   * Only users who may grant node permissions get the nodegrants form, and with
   * it the submit handler that rewrites this node's grants.
   */
  if (!\Drupal::currentUser()->hasPermission('grant node permissions')) {
    return;
  }

  $form['nodegrants'] = [
    '#type' => 'details',
    '#title' => t('Nodegrants'),
    '#group' => 'advanced',
    '#attributes' => [
      'class' => ['node-form-nodegrants']
    ],
    '#attached' => [
      'library' => ['node/drupal.node'],
    ],
    '#weight' => -1,
    // Not #optional: that hides a group holder with no grouped members, and
    // the table below is an ordinary child, not a member.
    '#open' => FALSE,
    'table' => [
      '#type' => 'table',
      '#header' => [
        t('Role'),
        t('View'),
        t('Edit'),
        t('Del'),
      ],
      '#weight' => 10,
      '#attached' => [
        'library' => [
          'nodegrants/form-styling',
        ],
      ],
    ],
  ];

  /**
   * The sidebar ("advanced" group) only renders in themes with a two-column
   * node form: Claro, Default Admin (its Drupal 12 replacement) and their
   * sub-themes. In any other theme, move the pane to the top of the form.
   */
  $active_theme = \Drupal::theme()->getActiveTheme();
  $theme_chain = array_merge([$active_theme->getName()], array_keys($active_theme->getBaseThemeExtensions()));
  if (!array_intersect($theme_chain, ['claro', 'default_admin'])) {
    unset($form['nodegrants']['#group']);
  }

  /**
   * Iterate through our roles and present the default option for each one. Include authors at
   * the bottom of the list.
   *
   * Rationale:
   * If there are no grants for a particular piece of content, then we should display
   * the defaults. Keep in mind, this does not mean if no grants are given, defaults
   * should only be displayed if no grant records exist for a given node. Default grants
   * do not take into consideration user-specific grants, although this is an edge case
   * because saving a user-specific grant should save grants for the current node
   * as well.
   */
  $use_defaults = FALSE;
  $entries = [];
  if (!empty($nid)) {
    $entries = $db->select('nodegrants', 'n')
      ->fields('n')
      ->condition('nid', $nid, '=')
      ->execute()
      ->fetchAll();
    $node_count = count($entries);
    if ($node_count < 1) {
      $use_defaults = TRUE;
    }
  }
  else {
    $use_defaults = TRUE;
  }

  $user_entries = $role_entries = [];
  foreach ($entries as $entry) {
    $entry = (array) $entry;
    if ($entry['realm'] == 'nodegrants_uid') {
      $user_entries[$entry['gid']] = $entry;
    }
    if ($entry['realm'] == 'nodegrants_rid') {
      $role_entries[$entry['gid']] = $entry;
    }
  }

  /**
   * If authenticated users are allowed nodegrants, so are all roles not
   * named anonymous.
   */
  $allowed_roles = nodegrants_get_allowed_roles();
  $role_map = \Drupal::config('nodegrants.settings')->get('role_map');

  $i = 0;
  $permissions = ['view', 'update', 'delete'];
  foreach ($roles as $key => $role) {
    if (empty($allowed_roles[$key])) {
      continue;
    }

    foreach ($permissions as $permission) {
      $form['nodegrants']['table'][$key][$bundle . '_' . $key] = [
        '#markup' => $role->label(),
      ];
      $default_value = FALSE;
      if ($use_defaults === TRUE) {
        $default_value = $type->getThirdPartySetting('nodegrants', 'nodegrants_' . $bundle . '_' . $key . '_' . $permission, FALSE);
      }
      else {
        // Pull grants from our grants table. A role with no stored grant row
        // stays unchecked.
        $gid = $role_map[$key] ?? NULL;
        if ($gid !== NULL && isset($role_entries[$gid])) {
          $default_value = $role_entries[$gid]['grant_' . $permission];
        }
      }

      $form['nodegrants']['table'][$key][$bundle . '_' . $key . '_' . $permission] = [
        '#type' => 'checkbox',
        '#default_value' => $default_value,
      ];
    }
    $i++;
  }
  // Display the users we already have grants for.
  foreach ($user_entries as $gid => $entry) {
    $name = $db->select('users_field_data', 'ufd')
      ->fields('ufd', ['name'])
      ->condition('uid', $gid)
      ->execute()
      ->fetchField();

    /**
     * Skip grants for users that no longer exist. They are not re-inserted
     * when the node is saved, so saving cleans them up.
     */
    if ($name === FALSE) {
      continue;
    }

    /**
     * The remove route is CSRF protected. Keep the link as a render array so
     * its token placeholder is replaced at render time; flattening it to a
     * string would lose the placeholder and every removal would get a 403.
     */
    $query = ['nid' => $nid, 'uid' => $gid];
    $form['nodegrants']['table']['existing_user-'.$gid]['name'] = [
      'name' => [
        '#plain_text' => $name,
      ],
      'remove' => [
        '#type' => 'link',
        '#title' => t('remove'),
        '#url' => Url::fromRoute('nodegrants.remove.user', $query),
        '#prefix' => ' (',
        '#suffix' => ')',
      ],
    ];
    foreach ($permissions as $permission) {
      $form['nodegrants']['table']['existing_user-'.$gid][$gid . '-' . $permission] = [
        '#type' => 'checkbox',
        '#default_value' => $entry['grant_' . $permission],
      ];
    }
  }

  $form['nodegrants']['table']['user'][$bundle . '_user'] = [
    '#type' => 'textfield',
    '#size' => 30,
    '#maxlength' => 60,
    '#autocomplete_route_name' => 'nodegrants.autocomplete.users',
    // Lets the autocomplete leave out users already listed on this node.
    '#autocomplete_query_parameters' => !empty($nid) ? ['nid' => $nid] : [],
    '#element_validate' => ['nodegrants_new_user_validate'],
    '#default_value' => '',
  ];
  foreach ($permissions as $permission) {
    $form['nodegrants']['table']['user'][$bundle . '_user_' . $permission] = [
      '#type' => 'checkbox',
      '#default_value' => 0,
    ];
  }

  $form['bundle'] = [
    '#type' => 'hidden',
    '#default_value' => $bundle,
  ];

  foreach (array_keys($form['actions']) as $action) {
    if ($action != 'preview' && isset($form['actions'][$action]['#type']) && $form['actions'][$action]['#type'] === 'submit') {
      $form['actions'][$action]['#submit'][] = 'nodegrants_custom_entity_submit';
    }
  }
}

/**
 * Element validation for the new user grant field on node forms.
 *
 * The submit handler writes a row for every listed user and then one for the
 * new user, so adding a user who is already listed would violate the
 * nodegrants table's primary key. The autocomplete leaves listed users out,
 * but the "name [uid]" value can still be typed by hand.
 *
 * @see nodegrants_custom_entity_submit()
 */
function nodegrants_new_user_validate(array &$element, FormStateInterface $form_state) {
  if (preg_match('/^(.+) \[(\d+)\]$/', (string) $element['#value'], $matches)
    && $form_state->hasValue(['table', 'existing_user-' . $matches[2]])) {
    $form_state->setError($element, t('%name already has grants on this node. Change them in their row instead.', [
      '%name' => $matches[1],
    ]));
  }
}

/**
 * Our custom submit hook as defined in nodegrants_form_node_form_alter. This
 * is called after the content has already been saved to the database and the
 * node id is available for us to use.
 *
 * @see nodegrants_form_node_form_alter
 */
function nodegrants_custom_entity_submit($form, FormStateInterface $form_state) {

  $allowed_roles = nodegrants_get_allowed_roles();
  $db = \Drupal::database();
  $values = $form_state->getValues();
  $roles = Role::loadMultiple();
  $bundle = $values['bundle'];
  $type = NodeType::load($values['bundle']);
  $node = Node::load($values['nid']);

  $config = \Drupal::configFactory()->getEditable('nodegrants.settings');
  $roles_gids = $config->get('role_map');

  /**
   * We're going to re-write the access rules here, so clear out any that might
   * be there.
   */
  $q = $db->delete('nodegrants')
    ->condition('nid', $values['nid'])
    ->execute();
  $q = $db->delete('nodegrants_nodes_enabled')
    ->condition('nid', $values['nid'])
    ->execute();

  /**
   * Every save through the pane puts the node under nodegrants control: write
   * its role, user and author rows, then mark it enabled. There is no per-node
   * on/off toggle.
   */
  $grants = [];

  foreach ($values['table'] as $i => $permissions) {
    if (!isset($allowed_roles[$i]) || $allowed_roles[$i] != TRUE) {
      continue;
    }
    $grants[$i]['grant_view'] = (int) $values['table'][$i][$bundle . '_' . $i . '_view'];
    $grants[$i]['grant_update'] = (int) $values['table'][$i][$bundle . '_' . $i . '_update'];
    $grants[$i]['grant_delete'] = (int) $values['table'][$i][$bundle . '_' . $i . '_delete'];
  }

  foreach ($grants as $key => $grant) {
    $db->insert('nodegrants')
      ->fields([
        'nid' => $values['nid'],
        'gid' => $roles_gids[$key],
        'realm' => 'nodegrants_rid',
        'grant_view' => $grant['grant_view'],
        'grant_update' => $grant['grant_update'],
        'grant_delete' => $grant['grant_delete'],
      ])
      ->execute();
  }

  /**
   * Update user specific access roles.
   */
  $grant = [];
  foreach ($values['table'] as $key => $value) {
    $parts = explode('-', $key);
    if ($parts[0] != 'existing_user' || !isset($parts[1])) {
      continue;
    }

    foreach ($value as $combo => $permission) {
      $combo_parts = explode('-', $combo);
      $gid = $combo_parts[0];
      $perm = $combo_parts[1] ?? NULL;
      if (empty($perm)) {
        continue;
      }
      $grant[$gid]['grant_' . $perm] = $permission;
    }
    foreach ($grant as $gid => $perm) {
      $db->insert('nodegrants')
        ->fields([
          'nid' => $values['nid'],
          'gid' => $gid,
          'realm' => 'nodegrants_uid',
          'grant_view' => (int) $perm['grant_view'],
          'grant_update' => (int) $perm['grant_update'],
          'grant_delete' => (int) $perm['grant_delete'],
        ])
        ->execute();
    }
    $grant = [];
  }

  /**
   * Check for new user grants. Make sure the uid we're getting matches the user in the text.
   */
  if (!empty($values['table']['user'][$bundle . '_user'])) {
    // Expect the "name [uid]" format the autocomplete produces.
    $ids = [];
    $uid = NULL;
    if (preg_match('/^(.+) \[(\d+)\]$/', $values['table']['user'][$bundle . '_user'], $matches)) {
      $username = $matches[1];
      $uid = $matches[2];
      $query = $db->select('users_field_data', 'ufd')
        ->fields('ufd', ['uid', 'name'])
        ->condition('name', $username)
        ->condition('uid', $uid)
        ->execute();
      $ids = $query->fetchAll();
    }
    if (count($ids) == 1) {
      $db->insert('nodegrants')
        ->fields([
          'nid' => $values['nid'],
          'gid' => $uid,
          'realm' => 'nodegrants_uid',
          'grant_view' => (int) $values['table']['user'][$bundle . '_user_view'],
          'grant_update' => (int) $values['table']['user'][$bundle . '_user_update'],
          'grant_delete' => (int) $values['table']['user'][$bundle . '_user_delete'],
        ])
        ->execute();
    }
    else {
      \Drupal::messenger()->addError(t('The user-specific permissions could not be assigned.'));
    }
  }

  /**
   * Store the author grant from the content type defaults. Access doesn't
   * use this row: nodegrants_node_access_records() builds the author grant
   * for the node's current owner. It is kept so a node under nodegrants
   * control always has at least one row; the node form shows the content
   * type defaults when there are none.
   */
  $author_id = $node->getOwnerId();
  $db->insert('nodegrants')
    ->fields([
      'nid' => $values['nid'],
      'gid' => $author_id,
      'realm' => 'nodegrants_author',
      'grant_view' => (int) $type->getThirdPartySetting('nodegrants', 'nodegrants_' . $values['bundle'] . '_' . 'author_view', FALSE),
      'grant_update' => (int) $type->getThirdPartySetting('nodegrants', 'nodegrants_' . $values['bundle'] . '_' . 'author_update', FALSE),
      'grant_delete' => (int) $type->getThirdPartySetting('nodegrants', 'nodegrants_' . $values['bundle'] . '_' . 'author_delete', FALSE),
    ])
    ->execute();

  $db->insert('nodegrants_nodes_enabled')
    ->fields([
      'nid' => $values['nid'],
    ])
    ->execute();

  \Drupal::entityTypeManager()->getAccessControlHandler('node')->acquireGrants($node);

  $tags = ['node:' . $node->id()];
  Cache::invalidateTags($tags);
  $node->save();
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function nodegrants_form_alter(&$form, FormStateInterface $form_state, $form_id) {

  if ($form_id == 'node_type_add_form' || $form_id == 'node_type_edit_form') {

    $type = $form_state->getFormObject()->getEntity();
    // NULL on the add form: the machine name is only known at submit.
    $bundle = $type->id();
    $form['nodegrants'] = [
      '#type' => 'details',
      '#title' => t('Nodegrants'),
      '#group' => 'additional_settings',
      '#weight' => 90,
    ];
    $form['nodegrants']['enabled'] = [
      '#type' => 'checkbox',
      '#title' => t('Show grant tab for this node type.'),
      '#default_value' => $type->getThirdPartySetting('nodegrants', 'nodegrants_grant_tab_' . $bundle, FALSE),
    ];
    $form['nodegrants']['table'] = [
      '#type' => 'table',
      '#caption' => t(''),
      '#header' => [
        t('Role'),
        t('View'),
        t('Edit'),
        t('Delete'),
      ],
      '#id' => 'nodegrants-table',
      '#attached' => [
        'library' => [
          'nodegrants/form-styling',
        ],
      ],
    ];

    /**
     * Iterate through our roles and present the default option for each one. Include authors at
     * the bottom of the list.
     */
    /**
     * Checkbox keys leave the bundle out. On the add form it is not known
     * until submit, so the entity builder prefixes each key with the bundle
     * that was copied onto the entity.
     */
    $permissions = ['view', 'update', 'delete'];
    $roles = Role::loadMultiple();
    foreach ($roles as $key => $role) {
      $form['nodegrants']['table'][$key]['label'] = [
        '#markup' => $role->label(),
      ];
      foreach ($permissions as $permission) {
        $form['nodegrants']['table'][$key][$key . '_' . $permission] = [
          '#type' => 'checkbox',
          '#default_value' => $type->getThirdPartySetting('nodegrants', 'nodegrants_' . $bundle . '_' . $key . '_' . $permission, FALSE),
        ];
      }
    }

    $form['nodegrants']['table']['author']['label'] = [
      '#markup' => 'Node Author (Not editable per node.)',
    ];
    foreach ($permissions as $permission) {
      $form['nodegrants']['table']['author']['author_' . $permission] = [
        '#type' => 'checkbox',
        '#default_value' => $type->getThirdPartySetting('nodegrants', 'nodegrants_' . $bundle . '_' . 'author_' . $permission, FALSE),
      ];
    }
    $form['#entity_builders'][] = 'nodegrants_node_type_edit_form_builder';
  }
}

/**
 * Entity builder for the nodegrants permissions form.
 *
 * @see nodegrants_form_node_type_edit_form_alter()
 */
function nodegrants_node_type_edit_form_builder($entity_type, NodeTypeInterface $type, &$form, FormStateInterface $form_state) {
  // Form values are copied onto the entity before the builders run, so the id
  // is set here on the add form too.
  $bundle = $type->id();
  $type->setThirdPartySetting('nodegrants', 'nodegrants_grant_tab_' . $bundle, (int) $form_state->getValue('enabled'));

  // Rows are keyed by role id or "author"; each value key is
  // "{role}_{view|update|delete}". The label cells have no value.
  foreach ($form_state->getValue('table', []) as $row) {
    foreach ($row as $key => $enabled) {
      $type->setThirdPartySetting('nodegrants', 'nodegrants_' . $bundle . '_' . $key, (int) $enabled);
    }
  }
  Cache::invalidateTags(['rendered']);
}

/**
 * Implements hook_ENTITY_TYPE_presave() for node_type.
 *
 * Turning nodegrants on or off for a content type changes what
 * nodegrants_node_access_records() returns for every node of that type, but
 * the node access table only picks that up on a rebuild. Flag one; core then
 * shows a "rebuild permissions" notice with a link on the admin pages. The
 * flag is used instead of rebuilding here so the admin can finish their
 * changes and rebuild once, as node_access_rebuild() recommends.
 */
function nodegrants_node_type_presave(NodeTypeInterface $type) {
  if ($type->isNew()) {
    return;
  }
  $original = \Drupal::entityTypeManager()->getStorage('node_type')->loadUnchanged($type->id());
  if ($original instanceof NodeTypeInterface && nodegrants_type_enabled($original) !== nodegrants_type_enabled($type)) {
    _nodegrants_flag_access_rebuild();
  }
}

/**
 * Flags the node access table for a rebuild.
 *
 * Drupal 11.4 moved this behind the NodeAccessRebuild service and deprecated
 * node_access_needs_rebuild(), which older 11.x releases still need.
 */
function _nodegrants_flag_access_rebuild(): void {
  if (class_exists('Drupal\node\NodeAccessRebuild')) {
    \Drupal::service('Drupal\node\NodeAccessRebuild')->setNeedsRebuild(TRUE);
  }
  else {
    node_access_needs_rebuild(TRUE);
  }
}

/**
 * Whether nodegrants is turned on for a content type.
 *
 * This is the "Show grant tab" setting on the content type form. While it is
 * off, nodes of the type keep any grants stored for them, but none apply:
 * nodegrants_node_access_records() and nodegrants_node_access() behave as if
 * the node had never been saved through the Nodegrants pane.
 */
function nodegrants_type_enabled(NodeTypeInterface $type): bool {
  return (bool) $type->getThirdPartySetting('nodegrants', 'nodegrants_grant_tab_' . $type->id(), FALSE);
}

/**
 * Get the roles that are permitted per node content.
 */
function nodegrants_get_allowed_roles() {
  $roles = Role::loadMultiple();
  $all_non_anonymous_roles = FALSE;
  $authenticated = $roles['authenticated'];
  if ($authenticated->hasPermission('include in nodegrants grants')) {
    $all_non_anonymous_roles = TRUE;
  }

  /** Determine which roles have nodegrants. */
  $allowed_roles = [];
  foreach ($roles as $id => $role) {
    if ($all_non_anonymous_roles === TRUE) {
      $allowed_roles[$id] = TRUE;
    }
    else {
      if ($role->hasPermission('include in nodegrants grants')) {
        $allowed_roles[$id] = TRUE;
      }
    }
  }
  return $allowed_roles;
}
